<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="B20Suite">
	<groups>
		<run>
			<exclude name="regression"></exclude>
			<!--<include name="smoke"></include>-->
		</run>
	</groups>
	<listeners>
		<listener class-name="seleniumpractices.MyListner" />
	</listeners>
	<test thread-count="5" name="Test">
		<classes>
			<class name="seleniumpractices.TestNgGroups" />
			<class name="seleniumpractices.SoftAssertOrVerify" />
			<class name="seleniumpractices.HardAssertOrAssert" />
		</classes>
	</test> <!--
	Test -->
</suite> <!--
Suite -->
